# Backend configuration. Copy to .env — every key is prefixed TRYON_.

TRYON_ENVIRONMENT=development
TRYON_DEBUG=true
TRYON_HOST=127.0.0.1
TRYON_PORT=8000

# SQLite for the MVP; swap for Postgres when you outgrow it.
# TRYON_DATABASE_URL=postgresql+psycopg://tryon:tryon@localhost:5432/tryon

# Phase 1 = overlay. Phase 2 = catvton | idm-vton
TRYON_DEFAULT_ENGINE=overlay
TRYON_CACHE_ENABLED=true
TRYON_MAX_UPLOAD_MB=12

# Absolute paths override the defaults (assets/clothes, backend/data/outputs, models/)
# TRYON_CLOTHES_DIR=/abs/path/assets/clothes
# TRYON_OUTPUT_DIR=/abs/path/backend/data/outputs
# TRYON_MODELS_DIR=/abs/path/models
